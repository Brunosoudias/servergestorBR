# Banco (PostgreSQL). Em desenvolvimento: `npm run db:up` (docker compose).
DATABASE_URL="postgresql://gestao:gestao_dev@localhost:5440/gestao?schema=public"

# Servidor
PORT=4000
NODE_ENV=development
# Origens do frontend permitidas (CORS com cookies), separadas por vírgula
WEB_ORIGINS=http://localhost:3000
# URL pública do frontend (links de e-mail: redefinição de senha, convite)
WEB_URL=http://localhost:3000

# URL pública da API (links das imagens enviadas) e pasta onde os arquivos são gravados
API_PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# Sessão (cookie httpOnly). Em produção: COOKIE_SECURE=true e, se front/API estiverem em
# subdomínios diferentes, COOKIE_DOMAIN=.seudominio.com.br
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# E-mail. SENDGRID_API_KEY tem prioridade (API HTTP do SendGrid; a chave precisa da permissão "Mail Send").
# MAIL_FROM precisa ser um Sender verificado no SendGrid (Single Sender ou domínio autenticado).
# Sem SendGrid nem SMTP => os e-mails são apenas registrados no log (desenvolvimento).
# MAIL_ENABLED liga o envio real. Enquanto for false (padrão), nada é enviado mesmo com a chave preenchida,
# "Esqueci minha senha" e convites por e-mail ficam desativados e só o superadmin define senhas.
MAIL_ENABLED=false
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gestor Br <nao-responder@seudominio.com.br>"

# Integrações externas (emissor fiscal, PSP do PIX, Open Finance, marketplaces, gateway de pagamento).
#  sandbox (padrão fora de produção): simuladas dentro da API e gravadas no banco, para desenvolver e testar o fluxo inteiro.
#  live (padrão em produção): usa os provedores reais; sem provedor contratado a API responde 503 dizendo o que falta.
INTEGRATIONS_MODE=sandbox
# Chave que criptografa segredos no banco (token CSC da NFC-e, segredo do 2FA). Obrigatória em produção: openssl rand -hex 32
SECRETS_KEY=

# Várias instâncias da API (escala horizontal). Sem estas variáveis, rode UMA instância só.
# REDIS_URL: limite de requisições compartilhado entre instâncias (ex.: redis://default:senha@host:6379).
REDIS_URL=
# S3_BUCKET: imagens enviadas vão para S3 (ou compatível: Cloudflare R2, MinIO) em vez do disco local.
# Credenciais pelas variáveis padrão da AWS (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) ou pelo papel IAM.
# S3_PUBLIC_URL: domínio público dos arquivos (CDN/CloudFront ou URL pública do bucket R2).
# S3_ENDPOINT + S3_FORCE_PATH_STYLE=true: para R2/MinIO.
S3_BUCKET=
S3_REGION=us-east-1
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
# Formato dos logs: json (padrão em produção, com X-Request-Id) ou text.
LOG_FORMAT=
