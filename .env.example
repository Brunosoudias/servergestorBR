# Banco (PostgreSQL). Em desenvolvimento: `npm run db:up` (docker compose).
DATABASE_URL="postgresql://gestao:gestao_dev@localhost:5440/gestao?schema=public"

# Servidor
PORT=4000
NODE_ENV=development
# Origens do frontend permitidas (CORS com cookies), separadas por vírgula
WEB_ORIGINS=http://localhost:3000
# URL pública do frontend (links de e-mail: redefinição de senha, convite)
WEB_URL=http://localhost:3000

# URL pública da API (links das imagens enviadas) e pasta onde os arquivos são gravados
API_PUBLIC_URL=http://localhost:4000
UPLOAD_DIR=uploads

# Sessão (cookie httpOnly). Em produção: COOKIE_SECURE=true e, se front/API estiverem em
# subdomínios diferentes, COOKIE_DOMAIN=.seudominio.com.br
SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# E-mail (SMTP). Vazio => os e-mails são apenas registrados no log (desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gestor Br <nao-responder@seudominio.com.br>"

# Integrações externas (emissor fiscal, PSP do PIX, Open Finance, marketplaces, gateway de pagamento).
#  sandbox (padrão fora de produção): simuladas dentro da API e gravadas no banco, para desenvolver e testar o fluxo inteiro.
#  live (padrão em produção): usa os provedores reais; sem provedor contratado a API responde 503 dizendo o que falta.
INTEGRATIONS_MODE=sandbox
# Chave que criptografa segredos no banco (token CSC da NFC-e). Obrigatória em produção: openssl rand -hex 32
SECRETS_KEY=
